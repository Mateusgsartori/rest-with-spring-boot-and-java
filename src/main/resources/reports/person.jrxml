	<query language="SQL"><![CDATA[SELECT id,
	CONCAT(first_name, ' ', last_name) AS name,
	address,
	gender,
	enabled,
	wikipedia_profile_url AS wikipediaProfileUrl,
	photo_url AS photoUrl
FROM spring_application_new.person
WHERE id = $P{PERSON_ID}]]></query>
